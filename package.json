{
  "name": "@muchaco/picord",
  "version": "0.4.0-muchaco.1",
  "type": "module",
  "description": "Discord integration extension for pi that maps project channels to workspaces and threads to native pi sessions.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-mono",
    "discord",
    "discord-bot",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muchaco/picord.git"
  },
  "homepage": "https://github.com/muchaco/picord#readme",
  "bugs": {
    "url": "https://github.com/muchaco/picord/issues"
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.spec.ts",
    "!src/**/*.spec.tsx",
    "README.md",
    "LICENSE",
    ".env.example",
    "picord.config.example.json",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts",
    "test": "vitest --run --passWithNoTests",
    "check:deps": "node scripts/check-dependency-boundary.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:deps",
    "doctor": "npm run build && node dist/doctor.js",
    "smoke:discord": "npm run build && node dist/discord-smoke.js",
    "sync:discord-commands": "npm run build && node dist/discord-sync-commands.js",
    "picord:start": "./scripts/picord.sh start",
    "picord:stop": "./scripts/picord.sh stop",
    "picord:restart": "./scripts/picord.sh restart",
    "picord:status": "./scripts/picord.sh status",
    "picord:logs": "./scripts/picord.sh logs"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
    "discord.js": "^14.19.3",
    "proper-lockfile": "^4.1.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.0.0 <2.0.0",
    "@earendil-works/pi-coding-agent": ">=1.0.0 <2.0.0",
    "typebox": ">=1.3.7 <2.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@eslint/js": "^9.24.0",
    "@types/node": "^24.3.0",
    "@types/proper-lockfile": "^4.1.4",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "eslint": "^9.24.0",
    "typebox": "1.3.7",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.30.1",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
